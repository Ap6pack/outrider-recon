{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://outrider.local/contracts/verification-v1.schema.json",
  "title": "Outrider verification verdict v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_type", "verdict_id", "run_id", "result_id", "request_id", "claim_id", "subject", "verdict", "rationale", "evidence_status", "scope_status", "created_by", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "contract_type": {"const": "verification"},
    "verdict_id": {"type": "string", "format": "uuid"},
    "run_id": {"type": "string", "format": "uuid"},
    "result_id": {"type": "string", "format": "uuid"},
    "request_id": {"type": "string", "format": "uuid"},
    "claim_id": {"type": "string", "format": "uuid"},
    "subject": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["supported", "refuted", "insufficient_evidence"]},
    "rationale": {"type": "string", "minLength": 1},
    "evidence_status": {"type": "string", "minLength": 1},
    "scope_status": {"type": "string", "minLength": 1},
    "created_by": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
